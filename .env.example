# ============================================================
# 星衍放射质控 — 环境变量配置
# 复制为 .env 后填写实际值（项目根目录或工作目录）
# ============================================================

# --- 质控引擎模式 ---
# rule  = 纯规则引擎（默认，离线可用）
# api   = 云端通义千问 API（需填写 QC_LLM_API_KEY）
# local = 本地 ollama（需 ollama serve 运行）
QC_ENGINE=rule

# --- 通义千问云端 API（QC_ENGINE=api 时生效）---
# 申请地址：https://dashscope.console.aliyun.com/
QC_LLM_API_KEY=
QC_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QC_LLM_MODEL=qwen-turbo-1101

# --- 本地 ollama（QC_ENGINE=local 时生效）---
# 需先运行 ollama serve
# 8GB 显存推荐：qwen3:4b 或 qwen2.5:7b-q4_k_m
# 4GB 显存推荐：qwen3:1.7b
QC_LLM_BASE_URL=http://localhost:11434/v1
QC_LLM_MODEL=qwen3:4b

# --- 通用设置 ---
QC_LLM_TIMEOUT=30          # LLM 超时（秒）
QC_LLM_MAX_RETRIES=2       # 最大重试次数
QC_LLM_FALLBACK=1          # 1=LLM 失败时自动降级到规则引擎，0=不降级

# --- 服务器配置 ---
QC_API_SECRET=change-me-in-prod   # API 鉴权密钥
QC_API_TTL=86400                   # Token 有效期（秒，默认 24h）
QC_OCR_MAX_BYTES=20971520          # OCR 图片最大字节（20MB）
