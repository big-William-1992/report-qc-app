# 星衍放射质控软件 — 环境变量配置模板
# 复制为 .env 后修改实际值，.env 不会被提交到 Git

# 服务监听
QC_HOST=127.0.0.1
QC_PORT=8000
QC_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 数据库（可选覆盖，默认 sqlite://assets/qc.db）
# QC_DB_OVERRIDE=postgresql://user:pass@localhost:5432/qc_db

# 数据接入推送端口鉴权密钥（PACS/RIS 系统推送报告时需在 X-API-Key 头携带此值）
PUSH_API_KEY=your-secret-key-here