# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/

# ---------- 运行时数据（样本库可能含患者信息，绝不入库） ----------
*.db
*.sqlite
*.sqlite3
assets/samples.db

# 用户本地规则配置：rules_config.json 是软件默认规则模板（含 R8 错别字库、R9 冲突、R10 模板），
# 必须随仓库分发，否则打包后的 exe 缺少该文件、R8 错别字检查会变空。运行时用户修改会写入 %APPDATA%。
# 仅 ris_config.json（院内 RIS 连接，含敏感信息且为可选功能）不入库。
assets/ris_config.json

# ---------- 打包产物 ----------
dist/
build/*.exe
build/*.dmg
build/*.app
# 发卡工具本地打包产物（体积大，非源码），排除
build/星衍发卡工具/
# 星衍影像云（独立产品）PyInstaller 打包配置：属另一项目，根目录 *.spec 不纳入质控软件仓库
# 注：用 *.spec 通配而非具体中文名，规避 macOS 文件名 NFD/NFC 规范化差异导致忽略失效
*.spec
# 保留打包脚本本身
!build/*.spec
!build/*.bat
!build/*.iss

# ---------- 系统 / IDE ----------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
keys/private_key.pem
# 运行时授权状态（含本机免责声明接受标记/激活状态），由软件生成，不入库
assets/license.dat
# 运行时登录会话（当前账号工号，由软件生成，不入库）
assets/session.json
# 整个 keys/ 目录不入库：私钥仅本地发卡用、公钥已内嵌客户端（license_utils.py）
keys/
# 开发者命令行发卡脚本（用私钥签名生成激活码）：不含私钥本身，但为减少仓库暴露，
# 仅本地保管，不入库；GUI 版（gen_activation_gui.py）与 Web 原型（web_issuer/）同理忽略。
gen_activation_code.py
# GUI 发卡工具 / Web 发卡原型（同属发卡工具，仅本地保管，不入库）
gen_activation_gui.py
web_issuer/
# 构建信息（供软件内检查更新比对），仅 CI 打包时写入，本地不入库避免陈旧值
assets/build_info.json
# 自动更新运行时缓存（下载的 tarball/zip、独立安装器、解包临时目录）
update/
# 桌面壳崩溃日志（desktop_app.py 启动失败时写入，含本机路径与堆栈，不入库）
crash.log
# UIA 真机自检证据（tools/uia_selfcheck.py 生成，可能含报告文本片段，涉及患者隐私，不入库）
uia_evidence/
# 星衍影像云.spec 已由上方 *.spec 规则忽略（属独立项目，不纳入质控软件仓库）

# ---------- 前端 E2E（Playwright）生成物 ----------
node_modules/
playwright-report/
test-results/
blob-report/

# 迁移备份与生成的文档产物（含患者数据或体积大，不入库）
assets/samples.db.bak
使用说明书.docx

# —— 本地训练数据与本地密钥，禁止入库 ——
data/
src/llm_config.json

# 训练产出的 LoRA 权重（二进制大文件，不入库；可由 tools/ + train/ 管线复现）
adapters/**/*.safetensors
adapters/**/tokenizer.json
adapters/**/tokenizer_config.json
adapters/**/special_tokens_map.json

# WorkBuddy 项目内部数据目录，非本软件产物，禁止入库
.workbuddy/
